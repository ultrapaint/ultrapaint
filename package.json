{
  "name": "ultrapaint",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node --experimental-strip-types scripts/dev-runner.ts",
    "dev:server": "pnpm -F @ultrapaint/server dev",
    "dev:web": "pnpm -F @ultrapaint/web dev",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "effect-tsgo patch --typescript --skip-missing",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "^0.45.0",
    "@types/node": "^24.0.0",
    "effect": "catalog:",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  }
}
