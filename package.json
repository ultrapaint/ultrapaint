{
  "name": "ultrapaint",
  "version": "0.1.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "ultrapaint": "./scripts/cli.ts"
  },
  "scripts": {
    "bench:canvas": "node scripts/bench-canvas.ts",
    "desktop:build": "pnpm -F @ultrapaint/desktop dist",
    "desktop:dev": "pnpm -F @ultrapaint/desktop dev",
    "dev": "node scripts/dev-runner.ts",
    "evals": "node evals/src/cli.ts",
    "format": "ultracite fix",
    "install:cli": "mkdir -p \"$HOME/.local/bin\" && ln -sf \"$PWD/scripts/cli.ts\" \"$HOME/.local/bin/ultrapaint\" && echo \"ultrapaint -> $HOME/.local/bin/ultrapaint (make sure that directory is on your PATH)\"",
    "lint": "ultracite check",
    "pack:local": "node scripts/pack.ts",
    "prepare": "effect-tsgo patch --typescript --skip-missing",
    "start": "node scripts/cli.ts",
    "test": "pnpm -r test && pnpm test:guards",
    "test:guards": "node --test scripts/test-guards.test.ts scripts/release-notes.test.ts",
    "test:shuffle": "pnpm -r --no-bail test -- --sequence.shuffle",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "^0.47.2",
    "@types/node": "^24.0.0",
    "effect": "catalog:",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  }
}
