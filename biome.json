{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "linter": {
    "rules": {
      "nursery": {
        "useReactCompiler": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/framework-react-vite/src/catalogue-extract.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": {
              "level": "error",
              "options": { "allow": ["&", "|"] }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/carousel.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "useReactCompiler": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
