# Scratch designs directories, configurations and logs of the ultrapaint servers a round starts.
.work/

# A round's pictures, pages and judgements stay on the machine that ran it; what it found is kept:
# its report, its proposals, its comparisons, and the skills it was run with.
runs/*/**
!runs/*/report.md
!runs/*/compare-*.md
!runs/*/round.json
!runs/*/gaps.json
!runs/*/proposals/
!runs/*/proposals/*.md
