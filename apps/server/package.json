{
  "name": "@ultrapaint/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrapaint": "./src/bin.ts"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "dev": "tsx watch --clear-screen=false src/bin.ts",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@google/design.md": "0.4.0",
    "@ultrapaint/acp": "workspace:*",
    "@ultrapaint/contracts": "workspace:*",
    "@ultrapaint/design-document": "workspace:*",
    "@ultrapaint/design-md": "workspace:*",
    "@ultrapaint/figma-import": "workspace:*",
    "@ultrapaint/framework-api": "workspace:*",
    "@ultrapaint/framework-react-vite": "workspace:*",
    "@ultrapaint/shared": "workspace:*",
    "@ultrapaint/style-tailwind-v4": "workspace:*",
    "@ultrapaint/system-components": "workspace:*",
    "effect": "catalog:",
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.0.0",
    "@ultrapaint/client-runtime": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
