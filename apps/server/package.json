{
  "name": "@ultrapaint/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrapaint": "./src/bin.ts"
  },
  "scripts": {
    "build": "esbuild src/bin.ts src/services/catalogue-worker.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --entry-names=[name] --out-extension:.js=.mjs --external:typescript-api --external:esbuild --external:@babel/parser --external:magic-string --external:tailwind-merge --external:effect --external:@effect/platform-node --external:html-to-image",
    "dev": "tsx watch --clear-screen=false src/bin.ts",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@effect/platform-node": "catalog:",
    "@ultrapaint/acp": "workspace:*",
    "@ultrapaint/contracts": "workspace:*",
    "@ultrapaint/host-plugin": "workspace:*",
    "@ultrapaint/shared": "workspace:*",
    "effect": "catalog:",
    "magic-string": "^1.4.1",
    "tailwind-merge": "^3.7.0",
    "typescript-api": "npm:typescript@^5.9.3"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ultrapaint/client-runtime": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
