{
  "name": "@ultrapaint/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ultrapaint": "./src/bin.ts"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/bin.mjs --external:typescript-api --external:esbuild --external:ws --external:chokidar --external:@babel/parser --external:magic-string --external:tailwind-merge --external:effect --external:html-to-image --external:typescript",
    "dev": "tsx watch --clear-screen=false src/bin.ts",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@ultrapaint/acp": "workspace:*",
    "@ultrapaint/contracts": "workspace:*",
    "@ultrapaint/host-plugin": "workspace:*",
    "@ultrapaint/shared": "workspace:*",
    "chokidar": "^5.0.0",
    "effect": "^3.22.2",
    "magic-string": "^1.4.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
